      "exit_codes": {"success": [0], "failure": [1]},
      "warning_policy": {"mode": "advisory", "description": "Non-blocking clichés are warnings; determinate mechanical issues can fail."},
      "artifact_policy": {
        "mode": "optional_outputs",
        "description": "Writes .codex/design/reviews only with --apply.",
        "paths": [".codex/design/reviews/"]
      },
      "safety_policy": {
        "network": "none",
        "writes_artifacts": true,
        "reads_secrets": false,
        "smoke_allowed": true,
        "description": "Never auto-installs Node; detector is available, skipped, or failed."
      },
      "wrapper_notes": "Not an aesthetic score. Independent rendered review is host-owned.",
      "smoke": {
        "argv": ["--project-root", "{repo_root}", "--files", "README.md", "--format", "json"],
        "expect_exit_codes": [0, 1],
        "cwd": "repo_root"
      }
    }
  ]
}
