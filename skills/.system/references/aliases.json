  "workflows": [
    {"alias": "$plan", "file": ".workflows/plan.md", "equivalent": "$codex-plan-writer + BMAD Phase 1-2"},
    {"alias": "$debug", "file": ".workflows/debug.md", "equivalent": "$codex-systematic-debugging + 4-phase root cause"},
    {"alias": "$create", "file": ".workflows/create.md", "equivalent": "workflow-create.md + TDD"},
    {"alias": "$build", "file": ".workflows/build.md", "equivalent": "alias of $create"},
    {"alias": "$prototype", "file": ".workflows/prototype.md", "equivalent": "$spec + $plan + role docs + full gate"},
    {"alias": "$review", "file": ".workflows/review.md", "equivalent": "workflow-review.md + output-guard + editorial"},
    {"alias": "$deploy", "file": ".workflows/deploy.md", "equivalent": "workflow-deploy.md + full gate"},
    {"alias": "$handoff", "file": ".workflows/handoff.md", "equivalent": "workflow-handoff.md + session summary"},
    {"alias": "$fix", "file": ".workflows/fix.md", "equivalent": "alias of $debug"},
    {"alias": "$docs", "file": ".workflows/docs.md", "equivalent": "alias of $handoff for documentation"},
    {"alias": "$refine", "file": ".workflows/refine.md", "equivalent": "Impeccable dial + $visual-gate"}
  ]
}
