    {"alias": "$tdd", "command": "$codex-test-driven-development", "skill": "codex-test-driven-development"},
    {"alias": "$red-green", "command": "$codex-test-driven-development", "skill": "codex-test-driven-development"},
    {"alias": "$root-cause", "command": "$codex-systematic-debugging", "skill": "codex-systematic-debugging"},
    {"alias": "$trace", "command": "$codex-systematic-debugging", "skill": "codex-systematic-debugging"},
    {"alias": "$sdd", "command": "$codex-subagent-execution", "skill": "codex-subagent-execution"},
    {"alias": "$dispatch", "command": "$codex-subagent-execution", "skill": "codex-subagent-execution"},
    {"alias": "$worktree", "command": "$codex-git-worktrees", "skill": "codex-git-worktrees"},
    {"alias": "$isolate", "command": "$codex-git-worktrees", "skill": "codex-git-worktrees"},
    {"alias": "$finish", "command": "$codex-branch-finisher", "skill": "codex-branch-finisher"},
    {"alias": "$finish-branch", "command": "$codex-branch-finisher", "skill": "codex-branch-finisher"},
    {"alias": "$verify", "command": "$codex-verification-discipline", "skill": "codex-verification-discipline"},
    {"alias": "$evidence", "command": "$codex-verification-discipline", "skill": "codex-verification-discipline"}
