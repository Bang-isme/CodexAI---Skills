{
  "version": "1.0",
  "modes": [
    "brainstorm",
    "thinking-partner",
    "implement",
    "debug",
    "review",
    "devils-advocate",
    "teach",
    "ship"
  ],
  "workflow_types": [
    "build",
    "fix",
    "review",
    "debug",
    "docs",
    "refactor",
    "deploy",
    "handoff",
    "plan",
    "create",
    "prototype",
    "refine"
  ],
  "workflow_aliases": {
    "build": "create",
    "fix": "debug",
    "docs": "handoff"
  },
  "confirmation_policy": {
    "needs_confirmation": {
      "clear_explicit_request_with_no_open_material_decisions": false,
      "material_ambiguity_without_safe_default": true,
      "unrequested_destructive_irreversible_high_impact_or_external_action": true,
      "scope_expansion": true
    },
    "authorization": {
      "explicit_request_authorizes_stated_scope": true,
      "extends_to_adjacent_work": false,
      "reversible_defaults_allowed_when_scope_is_clear": true
    },
    "plan_only_request": {
      "stop_after_plan": true
    },
    "implementation_request_using_plan": {
      "proceed_within_authorized_scope": true,
      "pause_on_unapproved_scope_or_risk": true
    },
    "preserved_review_gates": [
      "A required spec or design review remains a checkpoint when it presents a new artifact or material decision; approval covers only that artifact or decision."
    ]
  },
  "overlays": {
    "scrum": {
      "signals": [
        "backlog",
        "user story",
        "acceptance criteria",
        "refinement",
        "sprint planning",
        "sprint backlog",
        "sprint goal",
        "daily scrum",
        "sprint review",
        "retrospective",
        "release readiness",
        "product owner",
        "scrum master"
      ],
      "aliases": [
        "$scrum-install",
        "$scrum-update",
        "$sprint-plan",
        "$story-ready-check",
        "$story-delivery",
        "$retro",
        "$release-readiness"
      ],
      "coordination_overlay": "scrum"
    },
    "reasoning_rigor": {
      "signals": [
        "$codex-reasoning-rigor",
        "don't be generic",
        "go deeper",
        "make it specific",
        "use the repo, not generic advice"
      ]
    }
  },
  "output_contract": {
    "required_fields": [
      "mode",
      "workflow_type",
      "steps",
      "exit_criteria",
      "estimated_scope",
      "phase",
      "coordination_overlay",
      "ceremony"
    ]
  },
  "supports_native_codex_subagents": true,
  "execution_model": {
    "default": "sequential",
    "subagents": "available when native Codex custom agents are installed and explicitly selected"
  }
}
