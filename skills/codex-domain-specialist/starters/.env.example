# ============================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ============================================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_32_byte_random_secret_from_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_distinct_32_byte_refresh_secret_from_openssl
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
