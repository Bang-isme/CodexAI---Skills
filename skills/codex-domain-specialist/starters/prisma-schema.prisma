// ============================================================================
// Prisma Schema Starter — Production Multi-Tenant & SILC-002 Compliant
// Money in Cents (BigInt) + Optimistic Locking (version) + Idempotency + Outbox
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model User {
  id               String    @id @default(cuid())
  tenantId         String
  email            String
  name             String
  passwordHash     String
  role             Role      @default(USER)
  isActive         Boolean   @default(true)
  tokenVersion     Int       @default(0)
  refreshTokenHash String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  posts            Post[]
  sessions         Session[]

  @@unique([tenantId, email])
  @@index([tenantId, role, isActive])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
}

model Post {
  id          String     @id @default(cuid())
  tenantId    String
  authorId    String
  title       String
  slug        String
  content     String?    @db.Text
  budgetCents BigInt     @default(0)
  status      PostStatus @default(DRAFT)
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags        Tag[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, authorId])
  @@map("posts")
}

model Tag {
  id       String @id @default(cuid())
  tenantId String
  name     String
  posts    Post[]

  @@unique([tenantId, name])
  @@map("tags")
}

model Session {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  idempotencyKey String
  payloadHash    String
  statusCode     Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([tenantId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@map("outbox_events")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
